{
	// Cloudflare Workers config for VELOCITY, generated via @opennextjs/cloudflare.
	// PLACEHOLDER IDs below (marked <PLACEHOLDER>) must be replaced with real
	// resource IDs once `wrangler d1 create` / `r2 bucket create` /
	// `wrangler kv namespace create` are run at deploy stage (cloud-5b).
	// See docs: https://opennext.js.org/cloudflare
	"$schema": "node_modules/wrangler/config-schema.json",
	// cloud-4: was ".open-next/worker.js" (the OpenNext-generated handler
	// directly). Now points at a thin custom wrapper (worker-entry.ts) that
	// re-exports that same generated fetch handler unchanged AND adds the
	// StravaSyncWorkflow class as a named export — OpenNext's generated file
	// has no room for hand-written exports. See worker-entry.ts and
	// workers/sync-workflow.ts. FLAGGED FOR cloud-5b: this "main" redirect
	// must survive whatever deploy-time regeneration/verification Dock does.
	"main": "worker-entry.ts",
	"name": "velocity",
	// Bumped in cloud-5b-a from the 2024-09-23 minimum-for-nodejs_compat
	// floor to a current supported date.
	"compatibility_date": "2026-07-17",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

	// cloud-5b-b: explicit workers_dev opt-in. Safe now that the Cloudflare
	// Access application for velocity.onlinemyassistant.workers.dev exists
	// and gates the hostname before this flag ever takes effect on a real
	// deploy — see the cloud-5b-b report for the Access-app id.
	"workers_dev": true,
	// Version preview URLs get their own hostnames OUTSIDE the Access app's
	// coverage — an authentication bypass if left on. Wrangler enables them
	// by default when this key is absent; keep this false.
	"preview_urls": false,

	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	"services": [
		{
			// Self-reference service binding — required by OpenNext for the
			// Cloudflare cache/ISR machinery (queue + tag revalidation).
			// The service name must match "name" above.
			// See https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "velocity"
		}
	],

	// D1 — being wired up by the parallel Drizzle/D1 port. Binding name DB
	// per mission spec. Real database_id gets filled in after
	// `wrangler d1 create velocity-db` at deploy stage.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "velocity-db",
			"database_id": "a15034e0-a0e2-4762-9f22-7942ba371294",
				// cloud-5b-a: SQL migrations live alongside the Drizzle schema
				// (lib/db/migrations), not wrangler's default ./migrations —
				// point `wrangler d1 migrations apply` at the real location.
				"migrations_dir": "lib/db/migrations"
		}
	],

	// R2 — photo storage. Real bucket gets created via
	// `wrangler r2 bucket create velocity-photos` at deploy stage.
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "velocity-photos"
		},
		{
			// OpenNext incremental cache (ISR/data cache) — R2 chosen over KV
			// because KV's free tier write limit (1,000 writes/day) is too
			// tight for revalidation traffic; R2 free tier (10GB storage,
			// 1M Class A + 10M Class B ops/month) comfortably covers a
			// single-user app. See https://opennext.js.org/cloudflare/caching
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "velocity-opennext-cache"
		}
	],

	// Workflows — cloud-4, Strava sync runner. class_name must match the
	// export in worker-entry.ts (which re-exports it from
	// workers/sync-workflow.ts). No separate `name` is set for the Workflow
	// itself here since wrangler defaults it to `<worker-name>-<binding>`;
	// set one explicitly at deploy time if that default collides with
	// anything. Pricing (both Free and Workers Paid support Workflows, see
	// cloud-4 report) — no plan-gating concern.
	"workflows": [
		{
			"binding": "SYNC_WORKFLOW",
			"name": "velocity-strava-sync",
			"class_name": "StravaSyncWorkflow"
		}
	],

	// cloud-4: worker-entry.ts (this config's "main") imports shared lib/**
	// modules that start with `import 'server-only'`. That bare specifier
	// isn't a real resolvable package — Next.js vendors + aliases it via
	// webpack for its own build, which wrangler's esbuild pass knows nothing
	// about. Redirect it to a local no-op shim (matches what `server-only`
	// actually does outside a client bundle). See workers/shims/server-only.ts.
	"alias": {
		"server-only": "./workers/shims/server-only.ts"
	},

	// No "images" binding: grep of app/ and components/ found zero uses of
	// next/image, so there's nothing to route through Cloudflare's image
	// resizing. Add it back (see
	// https://opennext.js.org/cloudflare/howtos/image) only if next/image
	// gets adopted later — note the Images binding may require the paid
	// Cloudflare Images product on some accounts; verify before enabling
	// (flagged in the cloud-5a pricing findings).

	// No KV namespace: the R2 incremental cache above covers OpenNext's
	// cache needs. Add a kv_namespaces block only if a future OpenNext
	// version requires KV for tag-cache metadata.

	// No Durable Objects binding: this scaffold's open-next.config.ts only
	// overrides incrementalCache (R2). tagCache and queue stay at
	// @opennextjs/cloudflare's "dummy" (no-op) default, which needs no DO
	// and no D1 tag-cache table. Trade-off: on-demand revalidateTag/Path
	// won't propagate across instances — acceptable for a single-user app,
	// but flagged here since it's a deliberate choice, not an oversight.
	// See https://opennext.js.org/cloudflare/caching
}
